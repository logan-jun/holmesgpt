# HolmesGPT Air-Gapped Dockerfile
# Optimized for air-gapped (closed network) environments
# Removed: Microsoft ODBC (Azure SQL), Sentry
# Added: OS-level security patches, pip dependency check

# Go builder stage — build Go binaries from source with patched Go 1.25.7
FROM golang:1.25.7 AS go-builder

# Build Helm
ARG HELM_VERSION=v3.20.0
RUN git clone --depth 1 --branch ${HELM_VERSION} https://github.com/helm/helm.git /src/helm
WORKDIR /src/helm
RUN CGO_ENABLED=0 go build -ldflags="-s -w -X helm.sh/helm/v3/internal/version.version=${HELM_VERSION}" -o /out/helm ./cmd/helm \
    && /out/helm version

# Build ArgoCD CLI
ARG ARGOCD_VERSION=v3.3.1
RUN git clone --depth 1 --branch ${ARGOCD_VERSION} https://github.com/argoproj/argo-cd.git /src/argocd
WORKDIR /src/argocd
RUN CGO_ENABLED=0 go build -ldflags="-s -w -X github.com/argoproj/argo-cd/v3/common.version=${ARGOCD_VERSION}" -o /out/argocd ./cmd \
    && /out/argocd version --client

# Python builder stage
FROM python:3.13-slim-trixie AS builder
ENV PATH="/root/.local/bin/:$PATH"

RUN apt-get update \
    && apt-get install -y \
    curl \
    git \
    apt-transport-https \
    gnupg2 \
    build-essential \
    unzip \
    && apt-get purge -y --auto-remove \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /

# Create and activate virtual environment
RUN python -m venv /venv --upgrade-deps && \
    . /venv/bin/activate

ENV VIRTUAL_ENV=/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Needed for kubectl
ENV VERIFY_CHECKSUM=true \
    VERIFY_SIGNATURES=true
RUN curl -fsSL https://pkgs.k8s.io/core:/stable:/v1.34/deb/Release.key -o Release.key

# Go binaries from go-builder (built with Go 1.25.7)
COPY --from=go-builder /out/argocd /argocd
COPY --from=go-builder /out/helm /usr/local/bin/helm
RUN chmod 777 /argocd /usr/local/bin/helm

# Set up poetry
ARG PRIVATE_PACKAGE_REGISTRY="none"
RUN if [ "${PRIVATE_PACKAGE_REGISTRY}" != "none" ]; then \
    pip config set global.index-url "${PRIVATE_PACKAGE_REGISTRY}"; \
    fi \
    && pip install poetry
ARG POETRY_REQUESTS_TIMEOUT
RUN poetry config virtualenvs.create false
COPY pyproject.toml poetry.lock /
RUN if [ "${PRIVATE_PACKAGE_REGISTRY}" != "none" ]; then \
    poetry source add --priority=primary artifactory "${PRIVATE_PACKAGE_REGISTRY}"; \
    fi \
    && poetry install --no-interaction --no-ansi --no-root


# Final stage
FROM python:3.13-slim-trixie

ENV PYTHONUNBUFFERED=1
ENV PATH="/venv/bin:$PATH"
ENV PYTHONPATH=$PYTHONPATH:.:/app/holmes

WORKDIR /app

COPY --from=builder /venv /venv

# Install kubectl, then remove gnupg to eliminate CVE-2026-24882
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    curl \
    jq \
    apt-transport-https \
    gnupg2 \
    libexpat1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /Release.key Release.key
RUN cat Release.key | gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg \
    && echo 'deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/v1.34/deb/ /' | tee /etc/apt/sources.list.d/kubernetes.list \
    && apt-get update \
    && apt-get install -y kubectl \
    && apt-get purge -y --auto-remove gnupg gnupg2 gnupg-l10n gnupg-utils gpg gpg-agent gpg-wks-client gpgconf gpgsm dirmngr \
    && rm -rf /var/lib/apt/lists/* /Release.key

# NOTE: Microsoft ODBC (Azure SQL) intentionally removed for air-gapped environments

# Set up Go binaries (built from source with Go 1.25.7)
COPY --from=go-builder /out/helm /usr/local/bin/helm
COPY --from=go-builder /out/argocd /usr/local/bin/argocd
RUN chmod 555 /usr/local/bin/helm /usr/local/bin/argocd \
    && helm version \
    && argocd version --client

ARG AWS_DEFAULT_PROFILE
ARG AWS_DEFAULT_REGION
ARG AWS_PROFILE
ARG AWS_REGION

# Remove old setuptools/pip artifacts from base image
RUN rm -rf /usr/local/lib/python3.13/site-packages/setuptools-65.5.1.dist-info \
    && rm -rf /usr/local/lib/python3.13/ensurepip/_bundled/setuptools-65.5.0-py3-none-any.whl

# OS-level security patches for air-gapped compliance
RUN apt-get update && apt-get upgrade -y && apt-get clean && rm -rf /var/lib/apt/lists/*

# Upgrade Python packages with known vulnerabilities
RUN pip install --no-cache-dir \
    'setuptools>=79.0' 'jaraco.context>=6.1.0' 'wheel>=0.46.2' \
    'cryptography>=46.0.5' 'pillow>=12.1.1' \
    && rm -rf /usr/local/lib/python3.13/site-packages/setuptools/_vendor/jaraco.context-5.3.0.dist-info \
    && rm -rf /usr/local/lib/python3.13/site-packages/setuptools/_vendor/wheel-0.45.1.dist-info \
    && rm -rf /usr/local/lib/python3.13/site-packages/wheel-0.45.1.dist-info

# Remove ALL system pip artifacts (CVE-2018-20225 — disputed but flagged by scanners)
# venv retains pip 26.0.1 for runtime use
RUN rm -rf /usr/local/lib/python3.13/site-packages/pip*.dist-info \
    && rm -rf /usr/local/lib/python3.13/site-packages/pip \
    && rm -rf /usr/local/lib/python3.13/ensurepip/_bundled/pip-*.whl \
    && rm -rf /venv/lib/python3.13/site-packages/virtualenv/seed/wheels/embed/pip-2[0-5]*.whl

# Remove vulnerable embedded wheels from virtualenv (CVE-2026-24049, CVE-2025-47273)
# virtualenv bundles old wheel/setuptools .whl files for offline venv creation
RUN rm -f /venv/lib/python3.13/site-packages/virtualenv/seed/wheels/embed/wheel-0.45*.whl \
    && rm -f /venv/lib/python3.13/site-packages/virtualenv/seed/wheels/embed/setuptools-75*.whl


# Verify Python dependency integrity (warning only, does not fail build)
RUN pip check 2>&1 || echo "WARNING: pip check found dependency issues (non-blocking)"

COPY ./experimental/ag-ui/server-agui.py /app/experimental/ag-ui/server-agui.py
COPY ./holmes /app/holmes
COPY ./server.py /app/server.py
COPY ./holmes_cli.py /app/holmes_cli.py

ENTRYPOINT ["python", "holmes_cli.py"]
