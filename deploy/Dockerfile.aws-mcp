# AWS API MCP Server — Air-gapped / Hardened Image
# Base: python:3.13-slim-trixie (Debian, no Amazon Linux OpenSSL issues)
# Resolves all HIGH/CRITICAL CVEs from the official awslabs image

FROM python:3.13-slim-trixie

ENV PYTHONUNBUFFERED=1

# OS-level security patches
RUN apt-get update && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
    ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r app && useradd -r -g app -d /app -s /bin/bash app

WORKDIR /app

# Install aws-api-mcp-server and patch cryptography
RUN pip install --no-cache-dir \
    'awslabs.aws-api-mcp-server==1.3.13' \
    'cryptography>=46.0.5' \
    && pip cache purge 2>/dev/null || true

# Remove unnecessary pip/setuptools artifacts to reduce scan noise
RUN rm -rf /usr/local/lib/python3.13/ensurepip/_bundled/*.whl \
    && find /usr/local/lib/python3.13/site-packages/virtualenv/seed/wheels/embed/ \
       -name 'setuptools-[0-7][0-9]*' -delete 2>/dev/null || true \
    && find /usr/local/lib/python3.13/site-packages/virtualenv/seed/wheels/embed/ \
       -name 'wheel-0.4[0-5]*' -delete 2>/dev/null || true

# Create .aws directory for credential mounting
RUN mkdir -p /app/.aws && chown -R app:app /app

USER app

ENTRYPOINT ["awslabs.aws-api-mcp-server"]
